rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Only Valor accounts may write anything. The client checks the domain too,
    // but that is only for the error message — this is the enforcement, and it
    // must stay in step with `APP_SCHOOL_EMAIL_DOMAIN` in src/config/school.ts.
    function schoolMember() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[^@]+@valorschool\\.org$');
    }

    function isSelf(uid) {
      return schoolMember() && request.auth.uid == uid;
    }

    // The published 식단표. This is the one collection a signed-out student
    // must be able to read: 급식표 is the app's guest-first screen. Writes are
    // closed — menus go in through the Firebase console or an admin script,
    // never from the app.
    match /menus/{menuId} {
      allow read: if true;
      allow write: if false;
    }

    // Profiles are readable by any signed-in student so friend codes can be
    // looked up, but only the owner may write their own.
    match /users/{uid} {
      allow read: if schoolMember();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if isSelf(uid);

      // A friend list entry is written by its owner (accepting an invite) and
      // by the friend on the other side (mirroring a name change), which is why
      // the document id is allowed to authorise the write.
      match /friends/{friendUid} {
        allow read: if isSelf(uid);
        allow write: if isSelf(uid) || isSelf(friendUid);
      }
    }

    // Invites: the sender creates, either side deletes.
    match /friendRequests/{requestId} {
      allow read: if schoolMember()
        && (request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);
      allow create: if schoolMember()
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid;
      allow delete: if schoolMember()
        && (request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);
      allow update: if false;
    }

    // Crowd reports are append-only: anyone signed in can read the feed for
    // their school, and only the author can file or remove their own report.
    match /crowdReports/{reportId} {
      allow read: if schoolMember();
      allow create: if schoolMember()
        && request.auth.uid == request.resource.data.authorUid
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 5
        && request.resource.data.waitMinutes is int
        && request.resource.data.waitMinutes >= 0
        && request.resource.data.waitMinutes <= 180
        && request.resource.data.schoolKey is string
        && request.resource.data.note.size() <= 120;
      allow update: if false;
      allow delete: if schoolMember() && request.auth.uid == resource.data.authorUid;
    }

    // One rating per student per meal service. The document id carries the
    // rater, so a student can revise their own verdict but never add a second.
    match /mealRatings/{ratingId} {
      // Public, like the 식단표: a student deciding whether to walk over should
      // see today's score without signing in first. Writing still needs an
      // account, so the average can never be padded by anonymous traffic.
      allow read: if true;
      allow create, update: if schoolMember()
        && request.auth.uid == request.resource.data.raterId
        && ratingId == request.resource.data.serviceKey + '_' + request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.schoolKey is string
        && request.resource.data.date is string
        && request.resource.data.comment.size() <= 140;
      allow delete: if schoolMember() && request.auth.uid == resource.data.raterId;
    }

    // Presence powers Friend Radar. Readable by signed-in students, writable
    // only by the student it describes.
    match /presence/{uid} {
      allow read: if schoolMember();
      allow write: if isSelf(uid)
        && request.resource.data.uid == uid;
    }
  }
}
