# Copy to .env and fill in with your own project's values.
# Metro inlines every EXPO_PUBLIC_* variable at bundle time, so restart the
# dev server (npx expo start -c) after changing anything here.

# --- Firebase (required) -----------------------------------------------------
# Firebase console → Project settings → Your apps → Web app → SDK setup.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- NEIS (optional) ---------------------------------------------------------
# open.neis.go.kr serves anonymous requests capped at 100 rows, which is enough
# for one school. Register at open.neis.go.kr for a higher daily quota.
EXPO_PUBLIC_NEIS_API_KEY=
